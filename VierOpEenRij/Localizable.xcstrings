    },
    "Eenmalig · geen abonnement" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase · no subscription"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat unique · sans abonnement"
          }
        }
      }
    },
    "Gemaakt voor gezinnen, niet voor advertenties: niets dat meekijkt en geen abonnement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made for families, not for ads: nothing watching along, no subscription."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu pour les familles, pas pour la publicité : rien qui vous observe, aucun abonnement."
          }
        }
      }
    },
    "Hebben jullie na een pop allebei vier? Dan wint wie de steen wegtrok." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both have four after a pop? Then whoever pulled the disc wins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez tous les deux quatre après un retrait ? C'est celui qui a retiré le jeton qui gagne."
          }
        }
      }
    },
    "Het thema staat weer op Klassiek. Met de Gezinsversie blijft %@ gewoon aan — en de andere thema's ook." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The theme is back to Classic. With the Family Version %@ simply stays on — and so do the other themes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème est revenu à Classique. Avec la Version Famille, %@ reste activé — et les autres thèmes aussi."
          }
        }
      }
    },
    "Hier komt de trofeeënkast van %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s trophy case starts here"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitrine à trophées de %@ commence ici"
          }
        }
      }
    },
    "Hoort bij de Gezinsversie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part of the Family Version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait partie de la Version Famille."
          }
        }
      }
    },
    "In deze spelvorm mag je ook een steen van jouw kleur onderuit een kolom trekken. Alles erboven zakt een vakje." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this mode you may also pull a disc of your colour out from the bottom of a column. Everything above drops one space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans cette variante, tu peux aussi retirer un jeton de ta couleur par le bas d'une colonne. Tout ce qui est au-dessus descend d'une case."
          }
        }
      }
    },
    "KIES DE SPELVORM" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CHOOSE THE GAME MODE"
